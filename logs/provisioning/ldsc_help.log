               [--rg RG] [--ref-ld REF_LD] [--ref-ld-chr REF_LD_CHR]
               [--w-ld W_LD] [--w-ld-chr W_LD_CHR] [--overlap-annot]
               [--print-coefficients] [--frqfile FRQFILE]
