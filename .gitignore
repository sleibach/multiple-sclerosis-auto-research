.DS_Store
.venv/
.venv_v3_py312/
__pycache__/
*.pyc

# Downloaded source datasets: retrieve through scripts with recorded checksums.
data/raw/*
!data/raw/.gitkeep
data/raw_v2/*
!data/raw_v2/.gitkeep
data/raw_v3/*
!data/raw_v3/.gitkeep

# Large generated matrices are reproducible and should not be committed.
data/derived/*.csv.gz
data/derived/*.parquet
analysis/v21_ldsc_backdrop/sumstats_raw/
analysis/v21_ldsc_backdrop/munged/
tmp_v3/

# V49 repository hygiene: disposable temp/cache trees must never be staged.
phases/*/tmp/
**/tmp/

# V49 large generated/cache artifacts. Keep scoped because some compressed TSV
# outputs are legitimate small tracked summaries elsewhere.
phases/*/tmp/**/*.safetensors
phases/*/tmp/**/*.h5ad
phases/*/tmp/**/*.parquet
phases/*/tmp/**/*.tsv.gz
phases/v3/results/broad_h5ad_gene_discovery/broad_h5ad_gene_contrasts.tsv
results_v3/broad_h5ad_gene_discovery/broad_h5ad_gene_contrasts.tsv
analysis/v43_method_validation/synthetic/power_simulation_subjects.tsv.gz

# Public author code may be fetched for method inspection; record its revision.
external/
.env
