cific, stimulating the growth and differentiation of only human and murine erythroid progenitors"}],"commentType":"FUNCTION"},{"commentType":"SUBCELLULAR LOCATION","subcellularLocations":[{"location":{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"1730286"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"24635319"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"3010309"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"3839290"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"3903517"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"8541540"}],"value":"Secreted","id":"SL-0243"}}]}],"features":[{"type":"Binding site","location":{"start":{"value":24,"modifier":"EXACT"},"end":{"value":24,"modifier":"EXACT"}},"description":"","featureCrossReferences":[{"database":"ChEBI","id":"CHEBI:29105"}],"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"22427646"}],"ligand":{"name":"Zn(2+)","id":"ChEBI:CHEBI:29105","note":"ligand shared with metalloproteinase partner"}}],"extraAttributes":{"uniParcId":"UPI00001135B1"}},
