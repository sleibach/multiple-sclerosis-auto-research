        "descriptionModule": {
          "briefSummary": "The purpose of this study is to evaluate the efficacy, safety, and tolerability of BMS-986368 in participants with Multiple Sclerosis Spasticity"
        },
        "designModule": {
          "designInfo": {
            "allocation": "RANDOMIZED",
            "interventionModel": "PARALLEL",
            "maskingInfo": {
              "masking": "SINGLE",
              "whoMasked": [
                "PARTICIPANT"
              ]
            },
            "primaryPurpose": "TREATMENT"
          },
          "enrollmentInfo": {
