                  "source": "RuleBase"
                }
              ],
              "value": "Heterodimer with IL12B; disulfide-linked. The heterodimer is known as interleukin IL-12"
            }
          ]
        },
        {
          "commentType": "SUBUNIT",
          "texts": [
            {
              "evidences": [
