        "descriptionModule": {
          "briefSummary": "In the present project the investigators will evaluate whether glucagonotropic properties of the gut-derived incretin hormone glucose-dependent insulinotropic polypeptide (GIP) may be utilized as a safeguard against hypoglycemia in patients with T1D."
        },
        "designModule": {
          "designInfo": {
            "allocation": "RANDOMIZED",
            "interventionModel": "CROSSOVER",
            "interventionModelDescription": "Double blinded, randomized, cross-over study",
            "maskingInfo": {
              "masking": "DOUBLE",
              "maskingDescription": "The peptides/placebo is prepared, in a randomized fashion, by a laboratory assistant..",
              "whoMasked": [
                "PARTICIPANT",
                "INVESTIGATOR"
              ]
            },
            "primaryPurpose": "BASIC_SCIENCE"
          },
